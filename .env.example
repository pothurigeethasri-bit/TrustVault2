# Copy to .env (never commit .env)
DATABASE_URL=postgresql://user:password@localhost:5432/trustvault
SECRET_KEY=change-me-to-a-long-random-string     # python -c "import secrets;print(secrets.token_hex(32))"
SEED_PASSWORD=ChangeMe-Strong-Demo-Pass-1
STORAGE_BACKEND=disk            # "db" on hosts with an ephemeral disk (Render)
COOKIE_SECURE=0                 # 1 when served over HTTPS (production)
TRUST_PROXY=0                   # 1 behind Render's proxy so the real client IP is used for throttling

# ---- E-mail verification (SMTP) --------------------------------------------------------
# New users enter their e-mail first; a one-time link is mailed to it and they choose their
# username + password only after opening it. Without SMTP_HOST the app (dev only) prints the
# e-mail, including the link, to the server log instead of sending it. REQUIRED when COOKIE_SECURE=1.
SMTP_HOST=smtp.gmail.com        # e.g. smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net
SMTP_PORT=587                   # 587 for starttls, 465 for ssl
SMTP_SECURITY=starttls          # starttls | ssl | none  ("none" is refused in production)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=                  # Gmail: a 16-character App Password (needs 2-step verification), not your login password
SMTP_FROM=TrustVault <you@gmail.com>   # must be an address your provider lets you send from
APP_BASE_URL=http://127.0.0.1:5000     # public address used in e-mailed links; https://... in production
# Optional tuning (defaults shown)
EMAIL_TOKEN_MINUTES=30          # how long a verification link works
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_MAX_LINKS_PER_HOUR=5      # per e-mail address

# Security PIN gate. Empty = gate off (local dev only). REQUIRED when COOKIE_SECURE=1.
ACCESS_PIN=
# Optional tuning (defaults shown)
PIN_MAX_FAILURES_PER_IP=5
PIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=10
REGISTER_MAX_PER_IP_HOUR=5      # verification e-mails requested per IP per hour
RESET_REQUEST_MAX_PER_IP_HOUR=5

# Admin alert thresholds (defaults shown)
ALERT_FAILED_LOGINS_24H=5       # banner when this many failed sign-ins happen in 24h (all accounts)
ALERT_IP_FAILURES_24H=5         # flag an IP address with this many failed sign-ins in 24h
